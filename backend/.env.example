FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=sua-chave-secreta-aqui
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Firebase Project ID (used in both emulator and production modes)
FIREBASE_PROJECT_ID=profissional-os-app

# --- DEV MODE (Emulator) ---
# Uncomment the line below to use the Firestore emulator for local development
# Run start_emulator.bat in the project root to start the emulator
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- PRODUCTION MODE (Homolog/Prod) ---
# Required only when NOT using the emulator (comment out FIRESTORE_EMULATOR_HOST above).
# Download service account JSON from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# FIREBASE_CREDENTIALS=C:\path\to\service-account.json
